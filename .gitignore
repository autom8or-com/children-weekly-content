# Secrets — never commit
.env

# Checkpoint — tracks generation progress per Sunday, safe to delete to restart fresh
.claude/checkpoint.json

# Temp spec files written during generation
/tmp/tod_specs/

# Node dependencies
node_modules/

# playwright-cli session artifacts (snapshots, console logs) written at deck-build time
.playwright-cli/

# OS
.DS_Store

# Slides — generated image artifacts (large binary files, reproducible)
slides/projects/*/characters/*/reference.png
slides/projects/*/scenes/**/draft.png
slides/projects/*/scenes/**/output*.png
slides/projects/**/_backups/
slides/projects/*/collections/
slides/projects/*/output/*.pptx
slides/projects/*/output/collections/
slides/projects/*/output/*.zip
*.pyc
__pycache__/
.tmp.driveupload

# Git worktrees (transient working copies)
.worktrees/

# Slides — design-handoff template binaries (large, exported artifacts)
slides/_templates/*.pptx
slides/_templates/*.zip

# Videos — Remotion projects: generated media artifacts (large binary, reproducible)
videos/*/public/assets/
videos/*/public/audio/
videos/*/out/
videos/**/*.mp4
# revision deck writes Revision.pptx to project root (reproducible artifact)
slides/projects/*/*.pptx
