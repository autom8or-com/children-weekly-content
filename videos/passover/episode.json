      "duration_seconds": 12.086,
      "duration_frames": 363
    },
    {
      "id": "scene-04",
      "scene_type": "lesson",
      "title": "Memory Verse",
      "visual": {
        "id": "vis-04",
        "type": "image",
        "asset_file": "assets/scene-1c.png",
        "animation": "ken-burns",
        "verse_overlay": true
      },
      "dialogue": [
        {
          "id": "scene-04-line-01",
          "character": "Narrator",
          "text": "Here is our memory verse. Can you say it with me?",
          "emotion": "gentle",
          "audio_file": "audio/scene-04/scene-04-line-01.mp3",
          "duration_seconds": 3.274,
          "duration_frames": 98
        },
        {
          "id": "scene-04-line-02",
          "character": "Narrator",
          "text": "When I see the blood, I will pass over you. — Exodus twelve, thirteen.",
          "emotion": "gentle",
          "audio_file": "audio/scene-04/scene-04-line-02.mp3",
          "duration_seconds": 5.689,
          "duration_frames": 171
        }
      ],
      "sound_effects": [],
      "background_music": "bgm-main",
      "transition": "fade",
      "duration_seconds": 9.563,
      "duration_frames": 287
    },
    {
      "id": "scene-05",
      "scene_type": "lesson",
      "title": "Big Questions",
      "visual": {
        "id": "vis-05",
        "type": "image",
        "asset_file": "assets/scene-5a.png",
        "animation": "ken-burns"
      },
      "dialogue": [
        {
          "id": "scene-05-line-01",
          "character": "Narrator",
          "text": "Today we will find answers to three big questions.",
          "emotion": "curious",
          "audio_file": "audio/scene-05/scene-05-line-01.mp3",
          "duration_seconds": 3.808,
          "duration_frames": 114
        },
        {
          "id": "scene-05-line-02",
          "character": "Narrator",
          "text": "Why did God tell the Israelites to put blood on their doors?",
          "emotion": "curious",
          "audio_file": "audio/scene-05/scene-05-line-02.mp3",
          "duration_seconds": 4.087,
          "duration_frames": 123
        },
        {
          "id": "scene-05-line-03",
          "character": "Narrator",
          "text": "How did God keep His promise to deliver His people?",
          "emotion": "curious",
          "audio_file": "audio/scene-05/scene-05-line-03.mp3",
          "duration_seconds": 4.087,
          "duration_frames": 123
        },
        {
          "id": "scene-05-line-04",
          "character": "Narrator",
          "text": "And what does the Passover lamb remind us of today? Let's find out together!",
          "emotion": "happy",
          "audio_file": "audio/scene-05/scene-05-line-04.mp3",
          "duration_seconds": 5.7,
          "duration_frames": 171
        }
      ],
      "sound_effects": [],
      "background_music": "bgm-main",
      "transition": "fade",
      "duration_seconds": 19.482,
      "duration_frames": 584
    },
    {
      "id": "scene-06",
      "scene_type": "lesson",
      "title": "The Blood on the Door",
      "visual": {
        "id": "vis-06",
        "type": "section-header",
        "bg_color": "#2a1a45",
