        {
          "id": "scene-20-line-03",
          "start_frame": 378,
          "duration_frames": 161,
          "audio_file": "audio/scene-20/scene-20-line-03.mp3",
          "character": "Narrator",
          "text": "Jesus is the Lamb of God — and His blood covers us forever."
        }
      ],
      "sound_effects": [
        {
          "id": "sfx-gentle-chime-bridge",
