      "dialogue": [
        {
          "id": "scene-19-line-01",
          "start_frame": 0,
          "duration_frames": 327,
          "audio_file": "audio/scene-19/scene-19-line-01.mp3",
          "character": "Narrator",
          "text": "Moses taught the elders — this is a permanent law. From generation to generation, the Israelites will eat the Passover meal and remember this night."
        },
        {
          "id": "scene-19-line-02",
          "start_frame": 345,
          "duration_frames": 108,
          "audio_file": "audio/scene-19/scene-19-line-02.mp3",
          "character": "Narrator",
          "text": "To this day, the children of Israel remember."
        },
        {
          "id": "scene-19-line-03",
          "start_frame": 471,
          "duration_frames": 109,
          "audio_file": "audio/scene-19/scene-19-line-03.mp3",
          "character": "Narrator",
          "text": "When you remember what God has done, you stay strong!"
        }
      ],
      "sound_effects": [],
      "background_music": "bgm-main"
    },
    {
      "id": "scene-20",
      "scene_type": "lesson",
      "title": "The Bridge — The Lamb of God",
      "start_frame": 8575,
      "duration_frames": 539,
      "transition": "fade",
      "transition_frames": 15,
      "visual": {
        "id": "vis-20",
        "type": "image",
        "asset_file": "assets/scene-4a.png",
