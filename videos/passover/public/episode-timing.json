      "scene_type": "lesson",
      "title": "Keep This Day",
      "start_frame": 8010,
      "duration_frames": 580,
      "transition": "fade",
      "transition_frames": 15,
      "visual": {
        "id": "vis-19",
        "type": "image",
        "asset_file": "assets/scene-3c.png",
