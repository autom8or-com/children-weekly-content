    {
      "id": "scene-22",
      "scene_type": "lesson",
      "title": "Diary 1 — Pray, Don't Pay Back",
      "start_frame": 9258,
      "duration_frames": 555,
      "transition": "fade",
      "transition_frames": 15,
      "visual": {
        "id": "vis-22",
        "type": "image",
        "asset_file": "assets/scene-3a.png",
        "animation": "ken-burns",
        "diary_card": true
      },
      "dialogue": [
        {
          "id": "scene-22-line-01",
          "start_frame": 0,
          "duration_frames": 297,
          "audio_file": "audio/scene-22/scene-22-line-01.mp3",
          "character": "Angela",
          "text": "Number one! The Israelites were slaves for four hundred and thirty years. God told them to ask for their wages — and the Egyptians gave silver, gold, and clothing."
        },
        {
          "id": "scene-22-line-02",
          "start_frame": 315,
          "duration_frames": 240,
          "audio_file": "audio/scene-22/scene-22-line-02.mp3",
          "character": "Angela",
          "text": "I should pray for those who despitefully use me. I certainly will — because the children of Israel got the wages for their labor before they left!"
        }
      ],
      "sound_effects": [],
      "background_music": "bgm-main"
    },
    {
      "id": "scene-23",
      "scene_type": "lesson",
      "title": "Diary 2 — The Blood on My Door",
      "start_frame": 9798,
      "duration_frames": 439,
      "transition": "fade",
      "transition_frames": 15,
      "visual": {
        "id": "vis-23",
        "type": "image",
        "asset_file": "assets/scene-1c.png",
        "animation": "ken-burns",
        "diary_card": true
      },
      "dialogue": [
        {
          "id": "scene-23-line-01",
          "start_frame": 0,
          "duration_frames": 181,
          "audio_file": "audio/scene-23/scene-23-line-01.mp3",
          "character": "Angela",
          "text": "Number two! The blood on the door was the sign — this home belongs to God. The destroyer passed over."
        },
        {
          "id": "scene-23-line-02",
          "start_frame": 199,
          "duration_frames": 240,
          "audio_file": "audio/scene-23/scene-23-line-02.mp3",
          "character": "Angela",
          "text": "The blood of Jesus must be on me as a sign that I am a child of God — otherwise the messenger of death will come to me, like he came to the Egyptians."
        }
      ],
      "sound_effects": [],
      "background_music": "bgm-main"
    },
    {
      "id": "scene-24",
      "scene_type": "lesson",
      "title": "Diary 3 — God Keeps Every Promise",
      "start_frame": 10222,
      "duration_frames": 491,
      "transition": "fade",
      "transition_frames": 15,
      "visual": {
        "id": "vis-24",
        "type": "image",
        "asset_file": "assets/scene-2c.png",
        "animation": "ken-burns",
        "diary_card": true
      },
      "dialogue": [
