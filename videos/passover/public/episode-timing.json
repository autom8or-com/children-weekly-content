          "start_frame": 387,
          "duration_frames": 143,
          "audio_file": "audio/scene-18/scene-18-line-02.mp3",
          "character": "Narrator",
          "text": "After four hundred and thirty years — the very day — they were free!"
        },
        {
          "id": "scene-18-line-03",
          "start_frame": 548,
          "duration_frames": 123,
          "audio_file": "audio/scene-18/scene-18-line-03.mp3",
          "character": "Narrator",
          "text": "God keeps His promises down to the very day!"
        }
      ],
      "sound_effects": [
