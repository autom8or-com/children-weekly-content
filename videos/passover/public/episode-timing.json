          "audio_file": "audio/scene-01/scene-01-line-01.mp3",
          "character": "Narrator",
          "text": "Hello friends! Today we are going to learn about the Passover — when God used a mighty hand to save His people, with tender care."
        }
      ],
      "sound_effects": [
        {
          "id": "sfx-intro-chime",
          "start_frame": 0,
          "duration_frames": 75,
